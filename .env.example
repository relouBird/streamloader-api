# ─────────────────────────────────────────────────────────────────
#  .env — Environnement de TEST / DÉVELOPPEMENT LOCAL
# ─────────────────────────────────────────────────────────────────

# ── Serveur ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=5101
APP_URL=http://localhost:5500
API_URL=http://localhost:5101

# ── Service Video ───────────────────────────────────────────────
VIDEO_SERVICE_URL=http://localhost:5100
VIDEO_SERVICE_SECRET=dev_SECRET_VIDEO_SERVICE

# ── Auth / JWT ──────────────────────────────────────────────────
JWT_SECRET=dev_SECRET_AUTH_SERVICE

# ── Base de données MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=streamloader

# ── Paiement GeniusPay ────────────────────────────────────────────
GENIUSPAY_API_URL=https://geniuspay.ci/api/v1/merchant/payments
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=

# ── Paiement CinetPay ────────────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# ── Paiement Campay ──────────────────────────────────────────────
CAMPAY_USERNAME=
CAMPAY_PASSWORD=

# ── Paiement Wave ────────────────────────────────────────────────
WAVE_API_KEY=